<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#87CEEB"
    android:gravity="center_horizontal">

    <!-- PLAYER INPUT -->
    <EditText
        android:id="@+id/etGuess"
        android:hint="Your guess"
        android:inputType="number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnSubmit"
        android:text="Submit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:textAllCaps="false"
        android:background="#D2691E"
        android:textColor="#FFFFFF"/>



    <TextView
        android:id="@+id/tvWaiting"
        android:text="Waiting for opponent..."
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:layout_marginTop="6dp"
		android:layout_width="wrap_content"
        android:layout_height="wrap_content"
		/>

    <!-- HEADER -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
		
		
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
			android:layout_height="wrap_content"
			>

            <TextView android:text="YOU" android:textColor="#FFFFFF"
			android:layout_width="wrap_content"
           android:layout_height="wrap_content"
			/>

            <LinearLayout android:orientation="horizontal"
			android:layout_width="match_parent"
        android:layout_height="wrap_content"
			>
                <TextView android:text="Guess" android:layout_weight="1"
                    android:layout_width="0dp" 
					android:layout_height="wrap_content"
					android:textSize="9sp"
                    android:textColor="#FFFFFF"/>
                <TextView android:text="Number" android:layout_weight="1"
                    android:layout_width="0dp" 
				    android:layout_height="wrap_content"
					android:textSize="9sp"
                    android:textColor="#FFFFFF"/>
                <TextView android:text="Position" android:layout_weight="1"
                    android:layout_width="0dp" 
				    android:layout_height="wrap_content"
					android:textSize="9sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
		    android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView android:text="OPPONENT" 
			android:layout_width="wrap_content"
           android:layout_height="wrap_content"
			android:textColor="#FFFFFF"/>

            <LinearLayout android:orientation="horizontal"
		android:layout_width="match_parent"
           android:layout_height="wrap_content"
			>
                <TextView android:text="Guess" android:layout_weight="1"
                    android:layout_width="0dp" 
				   android:layout_height="wrap_content"
					android:textSize="9sp"
                    android:textColor="#FFFFFF"/>
                <TextView android:text="Number" android:layout_weight="1"
                    android:layout_width="0dp" 
				    android:layout_height="wrap_content"
					android:textSize="9sp"
                    android:textColor="#FFFFFF"/>
                <TextView android:text="Position" android:layout_weight="1"
                    android:layout_width="0dp" 
				    android:layout_height="wrap_content"
					android:textSize="9sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/resultContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>

</LinearLayout>